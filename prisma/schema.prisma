// Long Anh Corp — Prisma schema
// Postgres + column-per-locale i18n (_vi / _en / _zh)
//
// Sau khi clone repo, chạy:
//   npm install
//   npx prisma migrate dev --name init
//   npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// A. HỆ THỐNG & NGƯỜI DÙNG
// =============================================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  avatarUrl     String?
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id])
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  articlesAuthored Article[]            @relation("ArticleAuthor")
  contactsAssigned Contact[]            @relation("ContactAssignee")
  contactNotes     ContactNote[]
  jobApplicationsReviewed JobApplication[] @relation("JobAppReviewer")
  mediaUploaded    Media[]
  auditLogs        AuditLog[]
  chatSessions     ChatSession[]        @relation("ChatAgent")
  pagesUpdated     Page[]               @relation("PageEditor")
  settingsUpdated  Setting[]            @relation("SettingEditor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique           // super_admin | editor | sales | hr | viewer
  description String?
  permissions Json                       // { "products.create": true, ... }
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

model Setting {
  key         String   @id              // site.brand_short, site.phone_main…
  valueVi     String?
  valueEn     String?
  valueZh     String?
  valueType   String   @default("string") // string | json | number | url | bool
  group       String   @default("general")
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SettingEditor", fields: [updatedById], references: [id])

  @@map("settings")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // create | update | delete | login | logout
  entityType  String   // product | page | job | …
  entityId    String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// =============================================================
// B. ĐA NGÔN NGỮ
// =============================================================

model Language {
  code        String   @id              // vi | en | zh
  name        String
  flagEmoji   String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  @@map("languages")
}

model Translation {
  id        BigInt   @id @default(autoincrement())
  key       String                       // nav.home, hero.title_line1…
  locale    String                       // → languages.code
  value     String
  namespace String   @default("common")
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([namespace])
  @@map("translations")
}

// =============================================================
// C. SẢN PHẨM
// =============================================================

model ProductCategory {
  id            String  @id @default(uuid())
  slug          String  @unique
  nameVi        String
  nameEn        String?
  nameZh        String?
  descriptionVi String?
  descriptionEn String?
  descriptionZh String?
  iconUrl       String?
  coverImageUrl String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  products Product[]

  @@map("product_categories")
}

model Product {
  id             String   @id @default(uuid())
  code           String   @unique          // P-01, P-02…
  slug           String   @unique
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id])

  nameVi         String
  nameEn         String?
  nameZh         String?
  shortDescVi    String?
  shortDescEn    String?
  shortDescZh    String?
  longDescVi     String?  @db.Text
  longDescEn     String?  @db.Text
  longDescZh     String?  @db.Text

  coverImageUrl  String?
  gallery        Json?                       // ["url1","url2",...]

  moq            String?                     // "25 tấn"
  moqValue       Decimal? @db.Decimal(12, 2)
  moqUnit        String?
  productionTime String?                     // "7–14 ngày"

  coaFileUrl     String?
  msdsFileUrl    String?

  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  metaTitleVi    String?
  metaTitleEn    String?
  metaTitleZh    String?
  metaDescVi     String?
  metaDescEn     String?
  metaDescZh     String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants       ProductVariant[]
  applications   ProductApplication[]
  packagings     ProductPackaging[]
  specs          ProductSpec[]
  contacts       Contact[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantCode String                            // '3um', '8um', '1.6x2.4x18'
  labelVi     String
  labelEn     String?
  labelZh     String?
  price       Decimal? @db.Decimal(14, 2)
  currency    String   @default("VND")
  unit        String                            // 'tấn' | 'tấm' | 'm²'
  stock       Int      @default(0)
  isPopular   Boolean  @default(false)
  sortOrder   Int      @default(0)

  contacts    Contact[]

  @@unique([productId, variantCode])
  @@map("product_variants")
}

model ProductApplication {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameVi    String
  nameEn    String?
  nameZh    String?
  icon      String?
  sortOrder Int     @default(0)

  @@map("product_applications")
}

model ProductPackaging {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameVi    String
  nameEn    String?
  nameZh    String?
  icon      String?
  sortOrder Int     @default(0)

  @@map("product_packagings")
}

model ProductSpec {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  labelVi   String
  labelEn   String?
  labelZh   String?
  valueVi   String
  valueEn   String?
  valueZh   String?
  sortOrder Int     @default(0)

  @@map("product_specs")
}

// =============================================================
// D. PAGES & CONTENT
// =============================================================

model Page {
  id           String   @id @default(uuid())
  key          String   @unique         // home | about | products | career | contact
  slug         String?
  titleVi      String
  titleEn      String?
  titleZh      String?
  metaTitleVi  String?
  metaTitleEn  String?
  metaTitleZh  String?
  metaDescVi   String?
  metaDescEn   String?
  metaDescZh   String?
  ogImageUrl   String?
  isPublished  Boolean  @default(true)
  publishedAt  DateTime?
  updatedById  String?
  updatedBy    User?    @relation("PageEditor", fields: [updatedById], references: [id])
  updatedAt    DateTime @updatedAt

  sections PageSection[]

  @@map("pages")
}

model PageSection {
  id          String  @id @default(uuid())
  pageId      String
  page        Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionKey  String                          // hero | stats | cap_capacity
  sectionType String                          // hero | cards | timeline | cta
  content     Json                            // toàn bộ data của block
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  @@unique([pageId, sectionKey])
  @@map("page_sections")
}

model TimelineEvent {
  id        String  @id @default(uuid())
  year      Int
  titleVi   String
  titleEn   String?
  titleZh   String?
  bodyVi    String?
  bodyEn    String?
  bodyZh    String?
  imageUrl  String?
  sortOrder Int     @default(0)

  @@map("timeline_events")
}

model Certification {
  id             String  @id @default(uuid())
  code           String  @unique             // iso | reach | sgs | msds
  name           String                       // 'ISO 9001:2015'
  descriptionVi  String?
  descriptionEn  String?
  descriptionZh  String?
  badgeImageUrl  String?
  documentUrl    String?
  sortOrder      Int     @default(0)

  @@map("certifications")
}

model CoreValue {
  id        String  @id @default(uuid())
  scope     String                              // home | about | career
  titleVi   String
  titleEn   String?
  titleZh   String?
  bodyVi    String?
  bodyEn    String?
  bodyZh    String?
  icon      String?
  sortOrder Int     @default(0)

  @@index([scope])
  @@map("core_values")
}

model Stat {
  id        String  @id @default(uuid())
  key       String                               // years | capacity | countries
  value     String                               // '20+', '350,000'
  labelVi   String
  labelEn   String?
  labelZh   String?
  icon      String?
  scope     String                               // home | about
  sortOrder Int     @default(0)

  @@index([scope])
  @@map("stats")
}

// =============================================================
// E. NEWS / BLOG
// =============================================================

model NewsCategory {
  id      String  @id @default(uuid())
  slug    String  @unique
  nameVi  String
  nameEn  String?
  nameZh  String?
  color   String?

  articles Article[]

  @@map("news_categories")
}

model Article {
  id            String   @id @default(uuid())
  slug          String   @unique
  categoryId    String?
  category      NewsCategory? @relation(fields: [categoryId], references: [id])

  titleVi       String
  titleEn       String?
  titleZh       String?
  excerptVi     String?
  excerptEn     String?
  excerptZh     String?
  contentVi     String?  @db.Text
  contentEn     String?  @db.Text
  contentZh     String?  @db.Text

  coverImageUrl String?
  authorId      String?
  author        User?    @relation("ArticleAuthor", fields: [authorId], references: [id])
  tags          Json?                              // ["industry","export"]
  views         Int      @default(0)
  readTimeMin   Int?

  metaTitleVi   String?
  metaTitleEn   String?
  metaTitleZh   String?
  metaDescVi    String?
  metaDescEn    String?
  metaDescZh    String?

  isFeatured    Boolean  @default(false)
  status        String   @default("draft")        // draft | published | archived
  publishedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@index([status, publishedAt])
  @@map("articles")
}

// =============================================================
// F. TUYỂN DỤNG
// =============================================================

model Department {
  id     String @id @default(uuid())
  code   String @unique                          // manufacturing, sales…
  nameVi String
  nameEn String?
  nameZh String?

  jobs Job[]

  @@map("departments")
}

model Job {
  id              String   @id @default(uuid())
  slug            String   @unique
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])

  titleVi         String
  titleEn         String?
  titleZh         String?
  location        String?                         // 'Quỳ Hợp, Nghệ An'
  salaryMin       Decimal? @db.Decimal(14, 2)
  salaryMax       Decimal? @db.Decimal(14, 2)
  salaryCurrency  String   @default("VND")
  experienceVi    String?
  experienceEn    String?
  experienceZh    String?
  employmentType  String   @default("full_time")  // full_time | part_time | contract
  descriptionVi   String?  @db.Text
  descriptionEn   String?  @db.Text
  descriptionZh   String?  @db.Text
  responsibilities Json?                          // [{vi,en,zh}, ...]
  requirements    Json?
  benefits        Json?
  deadline        DateTime?
  slots           Int      @default(1)
  views           Int      @default(0)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications JobApplication[]

  @@index([departmentId])
  @@map("jobs")
}

model JobApplication {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])
  fullName     String
  email        String
  phone        String?
  cvUrl        String
  coverLetter  String?  @db.Text
  status       String   @default("new")          // new | reviewing | interview | offered | rejected | hired
  notes        String?  @db.Text
  reviewedById String?
  reviewedBy   User?    @relation("JobAppReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([jobId, status])
  @@map("job_applications")
}

// =============================================================
// G. CONTACTS / LEADS / CRM nhẹ
// =============================================================

model Contact {
  id                String   @id @default(uuid())
  fullName          String
  company           String?
  email             String
  phone             String?
  country           String?
  subject           String?
  message           String?  @db.Text

  productInterestId String?
  productInterest   Product? @relation(fields: [productInterestId], references: [id])
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id])

  quantity          String?
  destinationPort   String?
  source            String?                       // home_form | product_quote | contact_page
  status            String   @default("new")     // new | contacted | quoted | won | lost
  assignedToId      String?
  assignedTo        User?    @relation("ContactAssignee", fields: [assignedToId], references: [id])
  locale            String?
  ipAddress         String?
  userAgent         String?

  createdAt         DateTime @default(now())
  repliedAt         DateTime?

  notes ContactNote[]

  @@index([status])
  @@index([source])
  @@map("contacts")
}

model ContactNote {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  note      String   @db.Text
  createdAt DateTime @default(now())

  @@map("contact_notes")
}

// =============================================================
// H. MEDIA
// =============================================================

model MediaFolder {
  id       String  @id @default(uuid())
  name     String
  parentId String?
  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")
  path     String?

  media Media[]

  @@map("media_folders")
}

model Media {
  id           String   @id @default(uuid())
  filename     String
  originalName String?
  url          String
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?
  altVi        String?
  altEn        String?
  altZh        String?
  folderId     String?
  folder       MediaFolder? @relation(fields: [folderId], references: [id])
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([folderId])
  @@map("media")
}

// =============================================================
// I. MENU / NAVIGATION
// =============================================================

model Menu {
  id       String     @id @default(uuid())
  location String     @unique               // 'header' | 'footer'
  name     String

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id        String     @id @default(uuid())
  menuId    String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuTree")
  labelVi   String
  labelEn   String?
  labelZh   String?
  url       String
  target    String     @default("_self")     // _self | _blank
  icon      String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)

  @@index([menuId])
  @@map("menu_items")
}

// =============================================================
// J. LIVE CHAT
// =============================================================

model ChatSession {
  id              String        @id @default(uuid())
  visitorName     String?
  visitorEmail    String?
  visitorIp       String?
  locale          String?
  status          String        @default("open")   // open | closed
  assignedAgentId String?
  assignedAgent   User?         @relation("ChatAgent", fields: [assignedAgentId], references: [id])
  startedAt       DateTime      @default(now())
  endedAt         DateTime?

  messages ChatMessage[]

  @@index([status])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String      @id @default(uuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderType    String                                  // visitor | agent | bot
  senderId      String?
  message       String      @db.Text
  attachmentUrl String?
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}
