# Long Anh Corp — Production env (Path B, self-host with Docker Compose)
# -----------------------------------------------------------------------------
# Copy this file to `.env.production` and fill the blanks below.
# `docker compose -f docker-compose.prod.yml` reads it through `env_file`.
# DO NOT commit the filled-in `.env.production` — it is in .gitignore.

# ─── Domain + cert ────────────────────────────────────────────────────────────
# The bare domain (no scheme, no slash). The cert auto-includes www.<this>.
SERVER_NAME=example.com
# Email Let's Encrypt warns at when a cert is close to expiry.
LETSENCRYPT_EMAIL=ops@example.com

# ─── Database (Postgres container) ────────────────────────────────────────────
# Container creds — used to seed the postgres image AND by the app via
# DATABASE_URL below. Pick a strong password.
POSTGRES_USER=longanh
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_DB=longanh

# Connection strings consumed by Prisma. `postgres` here is the docker
# compose service name — leave it as-is. Quote the password if it has
# special characters.
DATABASE_URL="postgresql://longanh:replace-me-with-a-strong-password@postgres:5432/longanh?schema=public"
DIRECT_URL="postgresql://longanh:replace-me-with-a-strong-password@postgres:5432/longanh?schema=public"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="https://example.com"
# 32 random bytes — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Used in absolute URLs (sitemap, OG cards, JSON-LD). Must match NEXTAUTH_URL.
NEXT_PUBLIC_SITE_URL="https://example.com"

# ─── Email (Resend) — leave blank to disable outbound notifications ──────────
RESEND_API_KEY=
EMAIL_FROM="Long Anh <noreply@example.com>"
SALES_EMAIL=info@example.com
HR_EMAIL=hr@example.com

# ─── S3 media uploads — leave blank to keep images inline (data URLs) ────────
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN / custom public URL prefix (e.g. CloudFront). Without this,
# we use the bucket's default https://<bucket>.s3.<region>.amazonaws.com.
S3_PUBLIC_URL=

# ─── 3rd-party ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_KEY=

# Sentry — leave blank to disable error reporting. The DSN must be exposed
# to the browser bundle to capture client errors, hence NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=

# Optional Sentry traces sample rate (0 to disable, 1 to capture everything).
SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── Feature flags ───────────────────────────────────────────────────────────
ENABLE_LIVE_CHAT=false
ENABLE_REDIS_CACHE=false
