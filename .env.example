# =============================================================================
# Long Anh Corp — Environment variables template
# Copy this file to .env.local for local dev (not in docker)
# =============================================================================

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://longanh:longanh@localhost:5432/longanh?schema=public"
DIRECT_URL="postgresql://longanh:longanh@localhost:5432/longanh?schema=public"

# --- Auth ---------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=""
SALES_EMAIL="info@longanhcorp.com"
HR_EMAIL="hr@longanhcorp.com"

# --- S3 (media uploads) -------------------------------------------------------
# Leave blank to keep uploads inline as base64 data URLs (fine for dev).
# When set, the bucket must allow public read (bucket policy) or be fronted
# by a CDN — point S3_PUBLIC_URL at that CDN/base URL in that case.
S3_BUCKET=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- 3rd-party services -------------------------------------------------------
GOOGLE_MAPS_KEY=""
SENTRY_DSN=""
NEXT_PUBLIC_GA_ID=""

# --- Feature flags ------------------------------------------------------------
# "true" shows the public chat widget on every page; agents reply from
# /admin/livechat. Delivery is polling-based (no socket server needed).
ENABLE_LIVE_CHAT="false"
ENABLE_REDIS_CACHE="false"
